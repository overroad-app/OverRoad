<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Vehicle SDK 조회 퍼미션 (제어 퍼미션은 사용하지 않음) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 경고등(telltale) 조회에 필요. 마켓 심사 시 승인 여부 확인 필요 -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />

    <!-- 내비 위치·안내 조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 차량 속도 (AAOS 표준 속성) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- HyperConnect 서버 통신 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pleos TTS SDK (기기 내 음성 합성) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 화면 뒤에서도 경고 수신을 유지하는 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 내비 위에 경고를 띄우는 상단 알림 (Dangerous 권한, 런타임 요청) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 주행을 시작하면 내비를 앞으로 띄우기 위해 Pleos 내비 앱을 찾는다 (패키지 공개 범위) -->
    <queries>
        <package android:name="ai.umos.maps.android.navigation.app" />
    </queries>

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- 회전 컨트롤러(CCP) 미지원 앱 선언. 모든 조작은 터치로 완결된다 -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="차량 간 도로 위험 경고를 내비게이션이 앞에 있을 때도 실시간으로 받기 위함" />
        </service>

        <!-- Pleos 멀티 윈도우에서 창 크기·방향이 바뀌어도 화면을 다시 만들지 않는다 (연결·상태 유지) -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.HyperConnect.Floating"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
